# -----------------------------------------------------------------------------
# Vinay's Web Studio — Environment Variables
# Copy this file to ".env.local" for local development and fill in real values.
# NEVER commit ".env.local" (or any file with real secrets) to version control.
# In production (Vercel, etc.) set these in your hosting provider's dashboard.
# -----------------------------------------------------------------------------

# SMTP transport used by nodemailer in /src/app/api/contact/route.ts
# Example values shown are for Gmail; swap for your provider (SendGrid, Resend,
# Postmark, your own mail server, etc.) — just make sure the vars below match.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-smtp-app-password

# The mailbox that receives new lead notifications from the contact form.
CONTACT_EMAIL=vinays.web.server@gmail.com
